# Teeny Core Linux — pinned upstream versions.
# Override any of these on the command line (as environment variables)
# before running a build script, e.g.  KERNEL_VERSION=6.12.10 ./build/build-all.sh

ARCH=${ARCH:-x86_64}
JOBS=${JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)}
TC_VERSION=${TC_VERSION:-0.1.0}

# ---- kernel & userland ----------------------------------------------------
KERNEL_VERSION=${KERNEL_VERSION:-6.12.7}
BUSYBOX_VERSION=${BUSYBOX_VERSION:-1.36.1}
# wpa_supplicant does its own crypto; no OpenSSL needed in the base.
WPA_VERSION=${WPA_VERSION:-2.11}
LIBNL_VERSION=${LIBNL_VERSION:-3.10.0}

# ---- toolchain (v0.1 uses the build host's gcc/glibc) ---------------------
# A musl cross-toolchain is on the roadmap; see docs/roadmap.md.

# ---- sources --------------------------------------------------------------
KERNEL_URL=${KERNEL_URL:-https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$KERNEL_VERSION.tar.xz}
BUSYBOX_URL=${BUSYBOX_URL:-https://busybox.net/downloads/busybox-$BUSYBOX_VERSION.tar.bz2}
WPA_URL=${WPA_URL:-https://w1.fi/releases/wpa_supplicant-$WPA_VERSION.tar.gz}
LIBNL_URL=${LIBNL_URL:-https://github.com/thom311/libnl/releases/download/libnl3_10_0/libnl-$LIBNL_VERSION.tar.gz}
SIGNIFY_REPO=${SIGNIFY_REPO:-https://github.com/aperezdc/signify}
SIGNIFY_BRANCH=${SIGNIFY_BRANCH:-master}

# ---- repo (fill in once; tools/repo.env is the single place users edit) ---
REPO_URL=${REPO_URL:-}