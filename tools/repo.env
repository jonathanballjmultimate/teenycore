# Teeny Core — repo configuration. Edit the values at the top ONCE.
# Every tools/* script sources this file.

# ---- User config ----------------------------------------------------------
GITHUB_USER=${GITHUB_USER:-jonathanballjmultimate}
REPO_SLUG=${REPO_SLUG:-teenycore-repo}
REPO_URL=${REPO_URL:-https://${GITHUB_USER:-your-github-username}.github.io/$REPO_SLUG}

# ---- Derived paths (override only if you know what you're doing) ----------
_DIR=${ROOT:-$(pwd)}
REPO_DIR=${REPO_DIR:-$_DIR/repo}                # publish tree -> commit to teenycore-repo
KEYS_DIR=${KEYS_DIR:-$_DIR/keys}                # signify keypair (SECRET — never commit!)
KEY_NAME=${KEY_NAME:-teenycore}

# Signify binary used by the host-side tooling.
SIGNIFY=${SIGNIFY:-$_DIR/out/signify/signify}